{
  "name": "lockin",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first fullscreen focus environment for Windows",
  "author": "nakayesaa",
  "license": "UNLICENSED",
  "homepage": "https://github.com/nakayesaa/NgeLockinYukssz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakayesaa/NgeLockinYukssz.git"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "install-electron --no",
    "dev": "electron-vite dev",
    "dev:ui": "vite --config vite.ui.config.ts",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build && npm run verify:preload",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never && npm run verify:release",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:preload": "node scripts/verify-preload.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && electron-vite build && npm run verify:preload"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.1": true
  }
}
